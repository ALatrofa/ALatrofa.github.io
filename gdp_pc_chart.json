{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "GDP Per Capita",
    "subtitle": "Time series of GDP per capita in 6 selected countries (1990 – 2022)",
    "subtitleFontSize": 10,
    "anchor": "start",
    "color": "black"
  },
  "width": "container",
  "height": 300,
  "autosize": {"type": "fit", "contains": "padding"},
  "padding": {"left": 5, "top": 5, "right": 130, "bottom": 5},
  "background": null,
  "view": {"stroke": null},
  "data": {
    "url": "https://raw.githubusercontent.com/ALatrofa/ALatrofa.github.io/refs/heads/main/chart2_GDP_pc_6_countries.csv",
    "format": {"type": "csv", "parse": {"Year": "date"}}
  },
  "transform": [
    {"calculate": "year(datum.Year)", "as": "year"},
    {"filter": "datum.year > 1980"}
  ],
  "encoding": {
    "x": {
      "field": "Year",
      "type": "temporal",
      "title": null,
      "axis": {"gridOpacity": 0.4, "tickSize": 3, "labelFontSize": 11, "ticks": false, "labelPadding": 5}
    },
    "y": {
      "field": "GDP pc",
      "type": "quantitative",
      "title": null,
      "scale": {"domain": [0, 85000], "nice": false},
      "axis": {"format": "$,.0f", "gridOpacity": 0.4, "tickSize": 3, "labelFontSize": 11, "ticks": false, "labelPadding": 5}
    },
    "color": {
      "field": "Country Name",
      "title": null,
      "legend": null,
      "scale": {
        "scheme": "viridis",
        "domain": ["China", "Congo, Dem. Rep.", "India", "Nigeria", "United Kingdom", "United States"]
      }
    }
  },
  "layer": [
    {
      "mark": {"type": "line", "interpolate": "linear", "strokeWidth": 3}
    },
    {
      "mark": {"type": "point", "size": 200, "opacity": 0},
      "encoding": {
        "tooltip": [
          {"field": "Country Name", "title": "Country"},
          {"field": "Year", "type": "temporal", "title": "Year", "format": "%Y"},
          {"field": "GDP pc", "type": "quantitative", "title": "GDP per capita", "format": "$,.0f"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.year == 2022"}],
      "mark": {"type": "text", "align": "left", "dx": 6, "fontSize": 10},
      "encoding": {
        "text": {"field": "Country Name"},
        "color": {"value": "black"}
      }
    }
  ]
}
