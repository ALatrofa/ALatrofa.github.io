{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Wine Consumption",
    "anchor": "start",
    "subtitle": "Population over 11 consuming wine, %  | Source: Istat through ECO-API",
    "fontSize": 14,
    "subtitleFontSize": 12,
    "color": "#000000",
    "subtitleColor": "#000000"
  },
  "width": "container",
"height": 300,
"autosize": {"type": "fit", "contains": "padding"},
  "background": null,
  "view": {"fill": null, "strokeOpacity": 0},
  "data": {
    "url": "https://api.economicsobservatory.com/ita/wine?vega",
    "format": {"type": "json"}
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "axis": {"title": "", "grid": false}
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "scale": {"domain": [50,55.5], "nice": false},
      "axis": {"title": "", "grid": false}
    }
  },
  "layer": [
    {
      "mark": {"type": "area", "color": "#f4134b", "opacity": 0.25, "clip": true}
    },
    {
      "mark": {"type": "line", "interpolate": "linear", "strokeWidth": 3, "color": "#f4134b", "clip": true}
    },
    {
      "mark": {"type": "point", "size": 200, "opacity": 0, "clip": true},
      "encoding": {
        "tooltip": [
          {"field": "date", "type": "temporal", "title": "Year", "format": "%Y"},
          {"field": "value", "type": "quantitative", "title": "% of population", "format": ".1f"}
        ]
      }
    }
  ]
}
